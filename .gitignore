# Video files
*.mp4
*.webm
*.mov
*.mkv

# YOLO model
*.pt

# Python virtual environment
.venv/
.venv*/
__pycache__/
*.pyc

# Temporary files / runtime dirs
temp_*
uploads/
downloads/
videos/
output/

# DW-shorts desktop build output (Python prefix, ffmpeg, models) — generated by
# scripts/prefetch_models.py + the build pipeline, never committed (hundreds of MB).
# Ignore the directory's contents, but keep the macOS install helper in source.
desktop/resources/*
!desktop/resources/安装.command

# The packaged app and its build deps: ~2 GB of output plus node_modules.
# Both are produced by `electron-builder` / `npm install` in desktop/.
desktop/dist/
desktop/node_modules/
desktop/package-lock.json

# OS / IDE
.DS_Store
.idea/
.vscode/

# Secrets
.env

# Generated metadata
*_metadata.json

# Cache dirs
.cache/
.config/
# Multi-agent Skills
.agents/
.agent/
.claude/
.workbuddy/
# skills/ holds third-party installs (symlinks); our own published skill is versioned
skills/*
!skills/openshorts/
skills-lock.json


# Cloud env example kept local only (avoid leaking infra hints)
.env.cloud.example
.worktrees

# Instrucciones locales con datos de infra (repo público)
CLAUDE.local.md

# Local helpers for driving the remote Windows build machine over SSH.
# They are personal tooling, not part of the project.
scripts/remote.sh
scripts/remote-status.sh

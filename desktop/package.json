{
  "name": "dw-shorts",
  "version": "1.0.0",
  "description": "DW-shorts desktop app (macOS arm64 / Windows x64)",
  "main": "electron/main.js",
  "author": "DW-shorts",
  "private": true,
  "scripts": {
    "build:frontend": "npm --prefix ../dashboard install && npm --prefix ../dashboard run build",
    "build:python": "node scripts/build-python.mjs",
    "build:ffmpeg": "node scripts/build-ffmpeg.mjs",
    "prefetch:models": "python ../scripts/prefetch_models.py resources/models small",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "test:build": "node scripts/test-build-helpers.mjs",
    "prepare:source": "node ../scripts/prepare-source.mjs",
    "build:mac": "node scripts/build-macos.mjs",
    "build:win": "node scripts/build-windows.mjs",
    "dist:mac": "npm run build:frontend && electron-builder --config electron/builder-config.js --mac --arm64",
    "dist:win": "npm run build:frontend && electron-builder --config electron/builder-config.js --win --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  }
}
